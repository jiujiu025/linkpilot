# LinkPilot 设备级配置
# 由 init 脚本在启动 Agent 前 source，一行一个 KEY=VALUE，不要写 export。
# 现场改完执行：/etc/init.d/linkpilot restart
# 也可以直接用 lp-enroll <云端地址> <令牌> 改写本文件。

# 云端控制面地址（必须是 Agent 能主动出站访问到的地址）
LP_CLOUD_URL=http://127.0.0.1:18080

# 一次性注册令牌：注册成功后设备侧不再需要，建议注册完就清空
LP_ENROLL_TOKEN=

# 上报给云端的设备型号标识
LP_DEVICE_MODEL=N100 网关（LinkPilot）

# 本地门户端口与监听地址：0.0.0.0 才能被局域网终端访问，
# 真正的访问控制由 nftables input 链负责（只放行 br-lan，WAN 侧不可达）
LP_PORTAL_PORT=8088
LP_PORTAL_HOST=0.0.0.0

# 0 = 真应用（会写 nftables / UCI / 重启代理）；1 = 只落盘不生效
LP_DRY_RUN=0

# 设备本地状态目录，必须可写且能跨重启保留（overlay 上）
LP_AGENT_DIR=/etc/linkpilot/data

# 无无线网卡的机器不要动这一项，Agent 会按硬件事实自行关闭无线配置
# LP_FORCE_WIFI=0
